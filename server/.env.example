PORT=4000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# OTP policy (minutes / seconds / attempts)
OTP_VALIDITY_MIN=10
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MIN=15
SESSION_IDLE_HOURS=12

# Lead sync
DAILY_LEAD_QUOTA=50
SHEET_SYNC_MINUTES=15

# Google Sheets sync (leave empty to disable; credentials file must be a
# service-account JSON downloaded from Google Cloud Console)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_RANGE=Leads!A:H

# SMS/Email provider: "console" (logs OTP in server output) | "twilio" | "msg91"
OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
