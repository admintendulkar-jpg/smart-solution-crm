# Server Configuration
PORT=4000
NODE_ENV=production
APP_ORIGIN=http://localhost:5173

# Database & Storage
# Local development uses SQLite (DATA_DIR). On Render set DATABASE_URL to an
# external managed Postgres (Neon/Supabase) — Render's own free Postgres
# expires after 30 days and the instance filesystem is wiped on every
# redeploy/restart, so SQLite data would be lost.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Session & Security
JWT_SECRET=smartsolution-crm-secret-key-2024
SESSION_SECRET=smartsolution-session-secret-key-2024
SESSION_IDLE_HOURS=12

# Email & OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smartsolution.agency01@gmail.com
SMTP_PASS=pkcthylfrhbqlqnl
BREVO_API_KEY=

# Google Sheets Sync
